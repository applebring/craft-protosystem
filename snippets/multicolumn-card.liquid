{%- comment -%}
  Renders a single multicolumn/grid card item.
  Accepts:
  - block: {Object} mandatory
  - section: {Object} mandatory
  - highest_ratio: {Number} optional
  - columns_desktop: {Number} optional
  - columns_mobile: {Number} optional
{%- endcomment -%}

{%- liquid
  assign empty_column = ''
  if block.settings.image == blank and block.settings.title == blank and block.settings.text == blank and block.settings.link_label == blank
    assign empty_column = ' multicolumn-list__item--empty'
  endif

  assign num_desktop = columns_desktop | default: section.settings.columns_desktop | default: 3
  assign num_mobile = columns_mobile | default: section.settings.columns_mobile | default: 1
-%}

<li
  id="Slide-{{ section.id }}-{{ forloop.index }}"
  class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {{ block.shopify_attributes }}
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
    style="--animation-order: {{ forloop.index }};"
  {% endif %}
>
  <div class="multicolumn-card content-container">
    {%- if block.settings.image != blank -%}
      {%- liquid
        assign spaced_image = false
        if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle'
          assign spaced_image = true
        endif
      -%}
      <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
        <div
          class="media media--transparent media--{{ section.settings.image_ratio }}"
          {% if section.settings.image_ratio == 'adapt' and highest_ratio > 0 %}
            style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
          {% endif %}
        >
          {%- liquid
            assign grid_space_desktop = num_desktop | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
            assign grid_space_tablet = num_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
            assign grid_space_mobile = num_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
            
            if section.settings.image_width == 'half'
              assign image_width = 0.5
            elsif section.settings.image_width == 'third'
              assign image_width = 0.33
            else
              assign image_width = 1
            endif
          -%}
          {% capture sizes %}
            (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} / {{ num_desktop }}),
            (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ num_desktop }}),
            (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ num_mobile }}),
            calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ num_mobile }})
          {% endcapture %}
          {{
            block.settings.image
            | image_url: width: 3200
            | image_tag:
              widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
              sizes: sizes,
              class: 'multicolumn-card__image'
          }}
        </div>
      </div>
    {%- endif -%}
    <div class="multicolumn-card__info">
      {%- if block.settings.title != blank -%}
        <h3 class="inline-richtext">{{ block.settings.title }}</h3>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <div class="rte">{{ block.settings.text }}</div>
      {%- endif -%}
      {%- if block.settings.link_label != blank -%}
        <a
          class="link animate-arrow"
          {% if block.settings.link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ block.settings.link }}"
          {% endif %}
        >
          {{- block.settings.link_label | escape -}}
          <span class="svg-wrapper"
            ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
          >
        </a>
      {%- endif -%}
    </div>
  </div>
</li>