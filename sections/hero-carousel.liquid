{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .hero-carousel-{{ section.id }} {
    background-color: {{ section.settings.bgsection }};
    padding: {{ section.settings.paddingsection }};
    margin: {{ section.settings.marginsection }};
  }
  
  .hero-carousel-{{ section.id }} .swiper-slide {
    position: relative;
    overflow: hidden;
    height: auto;
    /* height: {{ section.settings.desktop_height }}px; */
  }

  /* 九宫格核心容器 */
  .banner-grid-container {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    padding: 8% 4%;
    box-sizing: border-box;
    pointer-events: none;
  }
  
  .banner-content-box {
    pointer-events: auto;
    max-width: {{ section.settings.content_max_width }}px;
    width: 100%;
    color: {{ section.settings.text_color }};
  }

  .banner-content-box .banner-title {
    font-size: {{ section.settings.heading_size }}px;
    font-family: var(--font-heading-family);
    color: {{ section.settings.text_color }};
    margin: 0 0 0 0;
  }

  .banner-content-box .banner-text {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
  }

  /* 遮罩层逻辑 */
  {% if section.settings.show_overlay %}
  .hero-carousel-{{ section.id }} .banner-media-wrap::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }
  {% endif %}

  /* 位置映射类 (scoped inside banner-grid-container) */
  .banner-grid-container .pos-top-left { justify-content: flex-start; align-items: flex-start; text-align: left; }
  .banner-grid-container .pos-top-center { justify-content: center; align-items: flex-start; text-align: center; }
  .banner-grid-container .pos-top-right { justify-content: flex-end; align-items: flex-start; text-align: right; }
  .banner-grid-container .pos-middle-left { justify-content: flex-start; align-items: center; text-align: left; }
  .banner-grid-container .pos-middle-center { justify-content: center; align-items: center; text-align: center; }
  .banner-grid-container .pos-middle-right { justify-content: flex-end; align-items: center; text-align: right; }
  .banner-grid-container .pos-bottom-left { justify-content: flex-start; align-items: flex-end; text-align: left; }
  .banner-grid-container .pos-bottom-center { justify-content: center; align-items: flex-end; text-align: center; }
  .banner-grid-container .pos-bottom-right { justify-content: flex-end; align-items: flex-end; text-align: right; }

  .banner-media-wrap, .banner-media-wrap img, .banner-media-wrap video {
    width: 100%; 
    height: 100%;
    /* object-fit: cover; */
  }
  /* 移动端cover */
  @media screen and (max-width: 767px) {
    .banner-grid-container{
      padding: 1rem 1rem;
    }
    .banner-content-box .banner-title{
      font-size: 16px;
      font-weight: 700;
    }
    .banner-media-wrap img, .banner-media-wrap video {
      object-fit: cover;
    }
  }

  /* 自定义分页器与箭头颜色 */
  .hero-carousel-{{ section.id }} .swiper-button-next,
  .hero-carousel-{{ section.id }} .swiper-button-prev { color: {{ section.settings.arrow_color }}; }
  
  /* 未激活时：标准小圆点 */
  .hero-carousel-{{ section.id }} .swiper-pagination-bullet { 
    background: {{ section.settings.dot_color }};
    width: 8px;
    height: 8px;
    border-radius: 50%;
    opacity: 0.4;
    transition: all 0.3s ease; /* 关键：让拉伸过程有丝滑的动画 */
  }
  
  /* 激活时：拉伸成长条圆角矩形 */
  .hero-carousel-{{ section.id }} .swiper-pagination-bullet-active { 
    background: {{ section.settings.dot_active_color }};
    opacity: 1;
    width: 24px;               /* 激活后的拉伸宽度 */
    border-radius: 4px;        /* 变成圆角矩形 */
  }

  /* @media screen and (max-width: 767px) {
    .hero-carousel-{{ section.id }} {
      padding: {{ section.settings.paddingmobile }};
      margin: {{ section.settings.marginmobile }};
    }
    .hero-carousel-{{ section.id }} .swiper-slide {
      height: {{ section.settings.mobile_height }}px;
    }
    .banner-content-box .banner-title {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    .banner-content-box .banner-text {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
    .banner-grid-container { padding: 20px; }
  } */

  /* Ensure the inner container constrains content and centers it */
  @media (min-width: {{ settings.container }}px){
    .banner-grid-container .container .pos-top-left,
    .banner-grid-container .container .pos-top-center,
    .banner-grid-container .container .pos-top-right,
    .banner-grid-container .container .pos-middle-left,
    .banner-grid-container .container .pos-middle-center,
    .banner-grid-container .container .pos-middle-right,
    .banner-grid-container .container .pos-bottom-left,
    .banner-grid-container .container .pos-bottom-center,
    .banner-grid-container .container .pos-bottom-right {
      width: 100%;
      display: flex;
      height: 100%;
      box-sizing: border-box;
    }
  }
{%- endstyle -%}

<div class="hero-carousel-{{ section.id }}" data-aos="{{ section.settings.animation }}">
  <common-swiper mode="media">
    <script type="application/json" data-swiper-config>
      {
        "slidesPerView": 1,
        "spaceBetween": 0,
        "loop": true,
        "watchOverflow": false,
        "observer": true,
        "observeParents": true,
        "speed": {{ section.settings.speed }},
        "simulateTouch": true,
        "grabCursor": true,
        {% if section.settings.autoplay %}
        "autoplay": {
          "delay": {{ section.settings.autoplay_speed }},
          "disableOnInteraction": false
        },
        {% endif %}
        "navigation": {
          "nextEl": ".swiper-button-next",
          "prevEl": ".swiper-button-prev"
        },
        "pagination": {
          "el": ".swiper-pagination",
          "clickable": true
        }
      }
    </script>

    <div class="swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="banner-media-wrap" style="display:block;">
            {%- else -%}
              <div class="banner-media-wrap">
            {%- endif -%}

              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 3840 | image_tag: sizes: '100vw' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank or block.settings.text != blank -%}
              <div class="banner-grid-container">
                <div class="container">
                  <div class="pos-{{ block.settings.text_position }}">
                    <div class="banner-content-box">
                      {%- if block.settings.title != blank -%}
                        <div class="banner-title">{{ block.settings.title | escape }}</div>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <div class="banner-text">{{ block.settings.text }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_arrows -%}
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      {%- endif -%}
      
      {%- if section.settings.show_dots -%}
        <div class="swiper-pagination"></div>
      {%- endif -%}
    </div>
  </common-swiper>
</div>

<script>
  (function () {
    if (customElements.get('common-swiper')) return;

    customElements.define(
      'common-swiper',
      class CommonSwiper extends HTMLElement {
        static config = () => ({
          slidesPerView: 1,
          spaceBetween: 10,
          breakpoints: {
            768: {
              spaceBetween: 24,
            },
            1240: {
              spaceBetween: 32,
            },
          },
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
        });

        constructor() {
          super();
          this.only_mobile = this.hasAttribute('only-mobile');
          this.only_desktop = this.hasAttribute('only-desktop');
          this.initAttempts = 0;
        }

        connectedCallback() {
          if (this.only_mobile && window.innerWidth > 768) return;
          if (this.only_desktop && window.innerWidth < 768) return;

          this.container = this.querySelector('.swiper');
          if (!this.container) return;
          if (!this.querySelectorAll('.swiper-slide')?.length) return;

          this.isMediaMode = this.getAttribute('mode') == 'media';
          if (this.isMediaMode) {
            this.medias = [];

            this.querySelectorAll('.swiper-slide').forEach((slide) => {
              const media = {};

              if (slide.querySelector('video')) {
                media.type = 'video';
                media.element = slide.querySelector('video');
                this.hasVideo = true;

                media.element.addEventListener('ended', () => {
                  this.waiting = false;
                  this.swiper && this.swiper.slideNext();
                });
              } else if (slide.querySelector('img')) {
                media.type = 'image';
                media.element = slide.querySelector('img');
              }

              this.medias.push(media);
            });
          }

          this.waitForSwiper();
        }

        waitForSwiper() {
          if (typeof window.Swiper === 'undefined') {
            this.initAttempts += 1;

            if (this.initAttempts <= 40) {
              window.setTimeout(() => this.waitForSwiper(), 100);
            }

            return;
          }

          this.initConfig();
        }

        initConfig() {
          this.config = this.getConfig();

          if (this.hasVideo) delete this.config.autoplay;

          if (this.hasAttribute('thumbnail')) {
            this.config.thumbs = {};

            const thumbnailElement = document.querySelector(this.getAttribute('thumbnail'));
            if (!thumbnailElement) {
              this.initSwiper();
              return;
            }

            if (
              (thumbnailElement.hasAttribute('only-mobile') && window.innerWidth > 768) ||
              (thumbnailElement.hasAttribute('only-desktop') && window.innerWidth < 768)
            ) {
              this.initSwiper();
              return;
            }

            if (thumbnailElement.swiper) {
              this.thumbnailSwiper = thumbnailElement.swiper;
              this.config.thumbs.swiper = thumbnailElement.swiper;
              this.initSwiper();
            } else {
              thumbnailElement.addEventListener('swiper-init', ({ detail: swiper }) => {
                this.thumbnailSwiper = swiper;
                this.config.thumbs.swiper = swiper;
                this.initSwiper();
              });
            }
          } else {
            this.initSwiper();
          }
        }

        initSwiper() {
          if (!this.config.on) this.config.on = {};

          if (!this.config.on.init) {
            this.config.on.init = function (swiper) {
              this.dispatchEvent(new CustomEvent('swiper-init', { detail: swiper }));

              if (this.config.autoplay && this.hasAttribute('mouse-stop')) {
                this.mouseHandler();
              }
            }.bind(this);
          }

          this.swiper = new Swiper(this.container, this.config);

          if (this.hasVideo) {
            this.startAutoPlay();
          }

          if (window.innerWidth < 768) return;

          if (this.querySelector('.left-swiper') && this.querySelector('.right-swiper')) {
            this.leftSwiper = new Swiper(this.querySelector('.left-swiper'), {
              loop: true,
              simulateTouch: false,
            });

            this.rightSwiper = new Swiper(this.querySelector('.right-swiper'), {
              loop: true,
              simulateTouch: false,
            });

            this.swiper.controller.control = [this.leftSwiper, this.rightSwiper];
          }
        }

        startAutoPlay() {
          this.waiting = false;
          this.task = null;

          const autoPlayNext = () => {
            if (this.waiting) return;

            clearTimeout(this.task);
            this.waiting = true;

            const media = this.medias[this.swiper.activeIndex];
            if (!media) return;

            if (media.type == 'video') {
              if (media.element.ended) {
                media.element.currentTime = 0;
              }

              media.element.play();
            } else {
              this.task = setTimeout(() => {
                this.task = null;
                this.waiting = false;
                this.swiper.slideNext();
              }, 3000);
            }
          };

          this.swiper.on('slideChange', () => {
            setTimeout(() => {
              autoPlayNext();
            }, 0);
          });

          autoPlayNext();
        }

        mouseHandler() {
          this.container.addEventListener('mouseenter', () => {
            this.swiper.autoplay.stop();
          });

          this.container.addEventListener('mouseleave', () => {
            this.swiper.autoplay.start();
          });
        }

        getConfig() {
          let config = JSON.parse(this.querySelector('script[data-swiper-config]')?.textContent || null) || null;
          config = config || CommonSwiper.config();

          if (config?.on) {
            config.on = this.formatFunction(config.on);
          }

          if (config?.breakpoints) {
            for (let key in config.breakpoints) {
              if (config.breakpoints[key]?.on) {
                config.breakpoints[key].on = this.formatFunction(config.breakpoints[key].on);
              }
            }
          }

          if (config.navigation) {
            if (typeof config.navigation.nextEl === 'string') {
              config.navigation.nextEl = this.querySelector(config.navigation.nextEl);
            }

            if (typeof config.navigation.prevEl === 'string') {
              config.navigation.prevEl = this.querySelector(config.navigation.prevEl);
            }
          }

          if (config.scrollbar && config.scrollbar.el) {
            config.scrollbar.el = this.querySelector(config.scrollbar.el);
          }

          if (
            this.querySelector('.swiper-pagination') ||
            this.closest('.swiper-father')?.querySelector('.swiper-pagination')
          ) {
            config.pagination = {
              el:
                this.querySelector('.swiper-pagination') ||
                this.closest('.swiper-father').querySelector('.swiper-pagination'),
              clickable: true,
            };
          } else {
            delete config.pagination;
          }

          return config;
        }

        formatFunction(oldOn) {
          const newOn = {};

          for (let key in oldOn) {
            if (oldOn[key]) {
              newOn[key] = new Function('return ' + oldOn[key])();
            }
          }

          return newOn;
        }

        getBeforeCreateEvent() {
          return swiperEvent[this.getAttribute('before-create')]?.bind(this) || null;
        }

        disconnectedCallback() {
          this.swiper?.destroy();
        }
      }
    );
  })();
</script>

{% schema %}
{
  "name": "Hero Carousel",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "setwidth", "label": "Width", "default": "full", "options": [{ "value": "full", "label": "Full" }, { "value": "boxed", "label": "Boxed" }] },
    { "type": "color", "id": "bgsection", "label": "Background Color", "default": "#ffffff" },
    { "type": "text", "id": "animation", "label": "Animation Class", "default": "fade-up" },
    { "type": "number", "id": "desktop_height", "label": "Desktop Height (px)", "default": 800 },
    { "type": "number", "id": "mobile_height", "label": "Mobile Height (px)", "default": 350 },
    { "type": "checkbox", "id": "autoplay", "label": "Enable Autoplay", "default": true },
    { "type": "number", "id": "autoplay_speed", "label": "Autoplay Delay (ms)", "default": 5000 },
    { "type": "number", "id": "speed", "label": "Slide Transition Speed (ms)", "default": 600 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show Arrows", "default": false },
    { "type": "checkbox", "id": "show_dots", "label": "Show Dots/Pagination", "default": true },
    { "type": "checkbox", "id": "show_overlay", "label": "Show Overlay", "default": false },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 10, "unit": "%", "label": "Overlay Opacity", "default": 20 },
    { "type": "color", "id": "arrow_color", "label": "Arrow Color", "default": "#ffffff" },
    { "type": "color", "id": "dot_color", "label": "Dot Pagination Color", "default": "#ffffff" },
    { "type": "color", "id": "dot_active_color", "label": "Dot Active Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "number", "id": "heading_size", "label": "Heading Size Desktop (px)", "default": 48 },
    { "type": "number", "id": "heading_size_mobile", "label": "Heading Size Mobile (px)", "default": 32 },
    { "type": "number", "id": "text_size", "label": "Text Size Desktop (px)", "default": 16 },
    { "type": "number", "id": "text_size_mobile", "label": "Text Size Mobile (px)", "default": 14 },
    { "type": "text", "id": "heading_weight", "label": "Heading Font Weight", "default": "700" },
    { "type": "number", "id": "content_max_width", "label": "Content Box Max Width (px)", "default": 600 },
    { "type": "text", "id": "paddingsection", "label": "Padding Section", "default": "0px 0px 0px 0px" },
    { "type": "text", "id": "paddingmobile", "label": "Padding Mobile", "default": "0px 0px 0px 0px" },
    { "type": "text", "id": "marginsection", "label": "Margin Section", "default": "0px 0px 0px 0px" },
    { "type": "text", "id": "marginmobile", "label": "Margin Mobile", "default": "0px 0px 0px 0px" }
  ],
  "blocks": [
    {
      "type": "carousel-slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Slide Link" },
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Description" },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text Position (9 Grids)",
          "default": "top-left",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "top-center", "label": "Top Center" },
            { "value": "top-right", "label": "Top Right" },
            { "value": "middle-left", "label": "Middle Left" },
            { "value": "middle-center", "label": "Middle Center" },
            { "value": "middle-right", "label": "Middle Right" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-center", "label": "Bottom Center" },
            { "value": "bottom-right", "label": "Bottom Right" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
